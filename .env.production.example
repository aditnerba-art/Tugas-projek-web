APP_NAME="TECKFO Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_TIMEZONE=+07:00
# Set a private absolute path writable by the application user.
DB_BACKUP_DIRECTORY=
DB_BACKUP_KEEP_DAYS=14
DB_PHOTO_BACKUP_DIRECTORY=
DB_PHOTO_BACKUP_KEEP_DAYS=30
DB_BACKUP_MINIMUM_BYTES=1024
# Set these to absolute executable paths if the binaries are not on PATH.
MYSQLDUMP_BINARY=mysqldump
PG_DUMP_BINARY=pg_dump
BACKUP_OFFSITE_DISK=
BACKUP_OFFSITE_PREFIX=teckfo-backups
BACKUP_ENCRYPTION_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
SFTP_HOST=
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_PRIVATE_KEY=
SFTP_PASSPHRASE=
SFTP_PORT=22
SFTP_ROOT=/backups/teckfo-service
SFTP_HOST_FINGERPRINT=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=teckfo_service
DB_USERNAME=change_me
DB_PASSWORD=

BCRYPT_ROUNDS=12
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

WHATSAPP_DRIVER=fonnte
FONNTE_TOKEN=
# WHATSAPP_DRIVER=wablas
WABLAS_TOKEN=
# WHATSAPP_DRIVER=cloud
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=

BROADCAST_CONNECTION=reverb
REALTIME_DRIVER=reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_APP_ID=change_me
REVERB_APP_KEY=change_me
REVERB_APP_SECRET=change_me
REVERB_HOST=example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_ALLOWED_ORIGINS=example.com
VITE_REALTIME_DRIVER="${REALTIME_DRIVER}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
# Comma-separated IPs/CIDRs of the trusted HTTPS reverse proxy. Keep blank when not proxied.
TRUSTED_PROXIES=
