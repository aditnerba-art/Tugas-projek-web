APP_NAME="TECKFO Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_TIMEZONE=+07:00
# Daily backups are stored outside the public web root.
DB_BACKUP_DIRECTORY=
DB_BACKUP_KEEP_DAYS=14
DB_PHOTO_BACKUP_DIRECTORY=
DB_PHOTO_BACKUP_KEEP_DAYS=30
DB_BACKUP_MINIMUM_BYTES=1024
# Set these to absolute executable paths if the binaries are not on PATH.
MYSQLDUMP_BINARY=mysqldump
PG_DUMP_BINARY=pg_dump
# Optional off-site copy. Configure the selected filesystem disk before enabling.
BACKUP_OFFSITE_DISK=
BACKUP_OFFSITE_PREFIX=teckfo-backups
# Generate with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
BACKUP_ENCRYPTION_KEY=
# S3-compatible disk credentials (used when BACKUP_OFFSITE_DISK=s3).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# SFTP disk credentials (used when BACKUP_OFFSITE_DISK=sftp).
SFTP_HOST=
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_PRIVATE_KEY=
SFTP_PASSPHRASE=
SFTP_PORT=22
SFTP_ROOT=/backups/teckfo-service
SFTP_HOST_FINGERPRINT=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
REALTIME_DRIVER=reverb
REVERB_APP_ID=local
REVERB_APP_KEY=local
REVERB_APP_SECRET=local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
VITE_REALTIME_DRIVER="${REALTIME_DRIVER}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
# Comma-separated proxy IPs/CIDRs. Leave blank unless using a trusted reverse proxy.
TRUSTED_PROXIES=
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

WHATSAPP_DRIVER=fonnte
FONNTE_TOKEN=
# WHATSAPP_DRIVER=wablas
WABLAS_TOKEN=
# WHATSAPP_DRIVER=cloud
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
